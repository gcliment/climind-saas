# Variables de entorno de Climind SaaS. Copiar a infra/.env y completar.
# Documentación completa: docs/ENVIRONMENT.md. NUNCA commitear el .env real.

# --- Base de datos ---
DB_PASSWORD=cambiar-por-una-clave-larga
# DB_URL=jdbc:postgresql://postgres:5432/climind_saas   (lo define docker-compose / EasyPanel)
# DB_USERNAME=climind

# --- URLs públicas ---
APP_PUBLIC_URL=http://localhost:8080
APP_PORTAL_URL=http://localhost:8080/saas/
# Host que muestra el portal en "/" (en producción: saas.climind-ia.com). Vacío = deshabilitado.
APP_PORTAL_HOST=
# Email de soporte que se muestra en la ayuda y en la landing. Vacío = no se muestra.
APP_SUPPORT_EMAIL=
# WhatsApp comercial (con código de país, ej. 5492211234567) para «Escribinos» (cotizador a medida). Vacío = usa el email.
APP_SUPPORT_WHATSAPP=

# --- Demos públicas (negocio ficticio en /c/demo/...; se crea al arrancar si falta) ---
APP_DEMO_ENABLED=true

# --- Baja de cuenta: plazo para arrepentirse antes de eliminar los datos ---
ACCOUNT_DELETION_GRACE=30d

# --- Sesión ---
# true en producción (HTTPS). false solo para pruebas locales por http://localhost.
COOKIE_SECURE=false
SESSION_TIMEOUT=7d

# --- Proxy / IP real del cliente ---
# Solo si TODO el tráfico entra por Cloudflare: CF-Connecting-IP. Si no, dejar vacío.
APP_CLIENT_IP_HEADER=

# --- Email (SMTP) ---
MAIL_PROVIDER=smtp
MAIL_FROM=Climind Cotiza <no-reply@climind-ia.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Super admin inicial (se crea una sola vez si no existe; luego conviene borrar la contraseña) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Pagos (Mercado Pago). Credenciales SOLO acá (backend); nunca en el frontend ni en el repositorio. ---
# PAYMENT_PROVIDER=fake solo existe en dev/test: con el perfil prod la app no arranca.
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Límites técnicos ---
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_PUBLIC_QUOTES_PER_MINUTE=30
RATE_LIMIT_PUBLIC_LEADS_PER_HOUR=10

# --- Documentación de la API (/api/docs). Mantener false en producción. ---
API_DOCS_ENABLED=false

# --- Backups (servicio "backup": infra/backup) ---
# Hora del backup diario (hora de Argentina) y días de retención (local y remoto).
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
# Copia fuera del VPS con rclone (recomendado). Ej.: r2:climind-backups/cotiza. Vacío = solo en el VPS.
RCLONE_REMOTE=
# Configuración del remoto por variables, en infra/backup.env (no en este archivo: así la app no las recibe).
# Ejemplo para Cloudflare R2 (ver docs/DEPLOYMENT.md#backups):
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
